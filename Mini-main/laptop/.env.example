# Copy to .env (never commit .env). The daemon reads these from the process environment.

# Policy file (relative paths inside it resolve against the laptop/ project root)
MINI_CONFIG=./config/policy.yaml

# Shared bearer token OpenClaw must present on /mcp (see openclaw/openclaw.mini.json "headers").
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MINI_PROXY_TOKEN=change-me-to-a-long-random-token

# Mini home: trusted_devices.json, dev signing key, secrets/ (outside approved roots, hard-denied)
MINI_HOME=~/.mini

# Dev mode enables /mobile-mock local signer endpoints. NEVER enable in production.
MINI_DEV_MODE=true

# L2 approval wait window before returning APPROVAL_PENDING to OpenClaw (seconds)
MINI_APPROVAL_WAIT_SECONDS=120

# Gmail worker. true = offline mock mailbox (CI / E2E), false = real Gmail API.
MINI_GMAIL_MOCK=true
# Only the Gmail MCP subprocess receives these two variables.
MINI_GMAIL_CLIENT_SECRETS=~/.mini/secrets/gmail_client_secret.json
MINI_GMAIL_TOKEN=~/.mini/secrets/gmail_token.json

# Git worker. true = offline mock mode (CI / local bare remotes), false = real HTTPS push.
MINI_GIT_MOCK=true
# Only the Git MCP subprocess receives these variables. Never logged or exposed to OpenClaw.
MINI_GIT_TOKEN=
MINI_GIT_USER_NAME=Mini Agent
MINI_GIT_USER_EMAIL=mini-agent@localhost
