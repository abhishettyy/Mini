{
  "tools": {
    "deny": [
      "group:runtime",
      "group:fs",
      "group:ui",
      "group:web",
      "group:automation",
      "group:nodes"
    ]
  },
  "mcp": {
    "servers": {
      "mini_proxy": {
        "url": "http://127.0.0.1:8765/mcp",
        "transport": "streamable-http",
        "enabled": true,
        "connectionTimeoutMs": 5000,
        "requestTimeoutMs": 180000,
        "headers": {
          "Authorization": "Bearer ${MINI_PROXY_TOKEN}"
        }
      }
    }
  },
 

"plugins": {
  "slots": {
    "memory": "none"
  }
},
"agents": {
  "defaults": {
    "bootstrapMaxChars": 500,
    "bootstrapTotalMaxChars": 1000
  }
}
}
